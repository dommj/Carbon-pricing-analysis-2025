Estimate credit volumes (with no baseline/eligibility) changes for new entrants:

```{r}
#intensity estimates were derived from 2023 NGER estimates and are only rough, do not account for improvements in tech over time.

intensity_class  <- read_excel('Data/intensity_estimates.xlsx') %>% 
  clean_names() %>% 
  rename(scope_1_emissions_intensity_kg_m_wh_as_gen = 3) %>% 
  select(-year) %>% unique()


step_change_credits_unadj <- step_change_gen %>% 
  ungroup() %>% 
  rename(class = technology) %>% 
  left_join(intensity_class) %>% 
  left_join(nem_baseline) %>% 
  mutate(smc_demand_mwh = scope_1_emissions_intensity_kg_m_wh_as_gen - baseline_kg_co2e_mwh,
         smc_demand = smc_demand_mwh * twh_gen * 1e6) %>% 
   filter(year <= 2050,
         year >= 2030,
         type != 'storage',
         class != 'DSP',
         class != 'Distributed PV') %>% 
  mutate(category = case_when(str_detect(class, 'coal') ~ 'Coal',
                            str_detect(class, 'gas') ~ 'Gas',
                            str_detect(class, '[w|W]ind') ~ 'Wind',
                            str_detect(class, 'solar') ~ 'Solar',
                            .default = 'Other renewables')) %>%  #group into wind, solar, other
  group_by(year, category) %>% 
  summarise(smc_demand = sum(smc_demand)) %>% 
  mutate(category = factor(category, levels = rev(unique(category))))

net_supply_unadj  <- step_change_credits_unadj  %>% 
  group_by(year) %>% 
  summarise(smc_demand = sum(smc_demand))
  
  ggplot() +
    geom_col(data = step_change_credits_unadj , 
           aes(x = year, y = smc_demand / 1e9, fill = category)) +
    geom_line(data = net_supply_unadj , 
            aes(x = year, y = smc_demand / 1e9), 
            color = "red", 
            size = 1) +
    geom_point(data = net_supply_unadj , 
            aes(x = year, y = smc_demand / 1e9), 
            color = "red", 
            size = 2)+
    theme_grattan() +
    labs(title = "Limiting SMC generation to new entrants",
       subtitle = "Net demand for SMCs (Million tons of CO2-e)",
       y = "", 
       x = "")
  
  grattan_save_pptx(p = ggplot2::last_plot(),
                  filename ='output/atlas/smc_demand_all_generators.pptx')
```

Estimate proportion generation new capacity:

```{r}

step_change_new_capacity <- read_excel('Data/2024 ISP generation and storage outlook/Core/2024 ISP - Step Change - Core.xlsx', 
                           sheet = 'Summary',
                           range = "H32:AJ46") %>% 
  clean_names() %>% 
  pivot_longer(cols = contains('20'), 
               names_to = 'year',
               values_to = 'gw_cap') %>% 
  rename(technology = 1) %>% 
  mutate(year = as.numeric(sub(".*_(\\d{2})", "20\\1", year)),
         type = case_when(str_detect(technology, 'coal')|
                            str_detect(technology, 'gas') ~ 'non-renewable',
                          str_detect(technology, '[w|W]ind')|
                            str_detect(technology, 'solar')|
                            str_detect(technology, 'PV')|
                            str_detect(technology, 'renewable')|
                            str_detect(technology, 'Hydro')|
                            str_detect(technology, 'DSP') ~ 'renewable',
                          .default = 'storage')) %>% 
  group_by(technology) %>% 
  mutate(gw_cap_new_2030 = gw_cap - gw_cap[year == 2029],
         gw_cap_new_2030 = if_else(gw_cap_new_2030 < 0 ,0, gw_cap_new_2030),
         gw_cap_new_ratio = gw_cap_new_2030 / gw_cap,
         gw_cap_new_ratio = if_else(is.nan(gw_cap_new_ratio), 0, gw_cap_new_ratio)) %>%
  # group_by(technology) %>% 
  # mutate(twh_gen_new_cum = cumsum(twh_gen_new_2030)) %>% 
  select(year, technology, gw_cap_new_ratio)


```

