Calculate and plot NEM emissions intensity over time:

```{r}

total_gen <- step_change_gen %>% 
  group_by(year) %>%
  summarise(twh_gen = sum(twh_gen))
  
nem_intensity <- total_gen %>% 
  full_join(step_change_ems %>% select(-scenario), join_by(year)) %>% 
  mutate(intensity_kg_co2e_mwh = (mt_co2e * 1e3 ) / (twh_gen))

nem_intensity %>% 
  ggplot(aes(x = year, y = intensity_kg_co2e_mwh)) +
  geom_line() +
  geom_point() +
  grattan_x_continuous() +
  grattan_y_continuous() +
  theme_grattan() +
  labs(title = "The emissions intensity of the NEM falls quickly, then slowly to 2040",
       subtitle = "Projected emissions intensity for the NEM (kg CO2-e per MWh)",
       y = "", 
       x = "")
  
```

Calculate straight-line NEM intensity baseline:

```{r}

start_year <- 2025

end_year <- 2040

start_base <- nem_intensity %>% 
  filter(year == start_year) %>% 
  pull(intensity_kg_co2e_mwh)

end_base <- nem_intensity %>% 
  filter(year == end_year) %>% 
  pull(intensity_kg_co2e_mwh)

nem_baseline <- nem_intensity %>% 
  filter(year %in% seq(2024,2040, by = 1)) %>% 
  mutate(baseline_kg_co2e_mwh = seq(start_base,end_base, 
                                    length.out = n())) %>% 
  select(year, baseline_kg_co2e_mwh) %>% 
  bind_rows(
    tibble(year = seq(2041,2050), 
              baseline_kg_co2e_mwh = seq(end_base, 0, 
                                         length.out = 10))
  )


  ggplot() +
    geom_line(data =nem_intensity, aes(x = year, y = intensity_kg_co2e_mwh), 
              linewidth = 1.5,
              colour = grattan_red) +
    geom_point(data = nem_intensity, aes(x = year, y = intensity_kg_co2e_mwh), 
                colour = grattan_red, fill = grattan_red) +
    
    geom_line(data = nem_baseline, aes(x = year, y = baseline_kg_co2e_mwh),
              linewidth = 1.5,) +
    geom_point(data = nem_baseline, aes(x = year, y = baseline_kg_co2e_mwh)) +
    grattan_x_continuous(limits = c(2025, 2050)) +
    grattan_y_continuous(limits = c(0, 500)) +
    theme_grattan() +
    labs(title = "Example straightline NEM emissions intensity baseline for existing generators",
       subtitle = "Emissions intensity for the NEM (kg CO2-e per MWh)",
       y = "", 
       x = "")
  
  grattan_save_pptx(p = ggplot2::last_plot(),
                  filename ='output/atlas/nem_baseline.pptx')
  
```

Apply 2030 baseline to existing generators:

```{r}

intensity_baseline_2030 <- nem_baseline %>% filter(year == 2030) %>% pull(baseline_kg_co2e_mwh)

intensity_all <- bind_rows(intensity_existing, intensity_new) %>% 
  mutate(technology = if_else(scope_1_emissions_intensity_kg_m_wh_as_gen == 0, 'Renewables', technology),
         technology = str_remove(technology, '\\s\\(.*\\)'))

intensity_all %>% 
  ggplot(aes(x = fct_reorder(technology, scope_1_emissions_intensity_kg_m_wh_as_gen, .fun = mean, .desc = TRUE), 
             y = scope_1_emissions_intensity_kg_m_wh_as_gen)) +
  geom_point(aes(size = 2, alpha = 0.6, colour = status)) +
  geom_hline(yintercept = intensity_baseline_2030, 
             linetype = "dotted", 
             color = "red",
             linewidth = 1.5) +
  coord_flip() +
  theme_grattan() +
  labs(title = "The vast majority of non-renewable generation will be above the emissions baseline in 2030",
       subtitle = "Emissions intensity for the NEM (kg CO2-e per MWh)",
       y = "", 
       x = "")

grattan_save_pptx(p = ggplot2::last_plot(),
                  filename ='output/atlas/emission_intensity_2030.pptx')

```

