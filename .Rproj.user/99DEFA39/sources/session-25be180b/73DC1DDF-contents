  clean_names() %>% 
  rename(scope_1_emissions_intensity_kg_m_wh_as_gen = 3) %>% 
  select(-year) %>% unique()

step_change_credits <- step_change_gen %>% 
  ungroup() %>% 
  rename(class = technology) %>% 
  left_join(intensity_class) %>% 
  left_join(nem_baseline) %>% 
  left_join(step_change_new_capacity %>% 
              rename(class = technology)) 

#Sense check total emissions:
est_emissions <- step_change_credits %>% 
  mutate(emissions = scope_1_emissions_intensity_kg_m_wh_as_gen * twh_gen * 1e6) %>%  group_by(year) %>% 
  summarise(emissions = sum(emissions),
            twh_gen = sum(twh_gen)) %>% 
  mutate(estimate_kg_co2_e = emissions / (twh_gen * 1e6)) %>% 
  left_join(nem_intensity %>% select(year, mt_co2e, intensity_kg_co2e_mwh )) %>% 
  mutate(scale_factor = mt_co2e * 1e9 / emissions) %>% 
  pivot_longer(cols = contains('kg_co2'))


est_emissions %>% 
  ggplot(aes(x = year, y = value, fill = name, colour = name)) +
  geom_line()

step_change_credits <- step_change_credits %>% 
  mutate(twh_gen_exist = twh_gen * (1 - gw_cap_new_ratio),
         twh_gen_new = twh_gen * (gw_cap_new_ratio),
         
         smc_demand = case_when(type == 'non-renewable' ~ twh_gen * (scope_1_emissions_intensity_kg_m_wh_as_gen - baseline_kg_co2e_mwh),
