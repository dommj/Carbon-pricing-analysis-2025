Load OECD medical practitioners data.

```{r}
#| echo: false
#| output: false
oecd_physician_per_cap <- read_excel('data/OECD/physicians_per_capita_long.xlsx', 
                           skip = 6) %>% 
  clean_names() %>% 
  rename(country = 1) %>% 
  select(-c(time_period_2, x27)) %>% 
  pivot_longer(cols = contains('x'), 
               names_to = 'year', 
               values_to = 'head_count_pc') %>% 
  mutate(year = str_remove(year, 'x') %>% as.numeric(),
         category = 'Physician') %>% 
  filter(!is.na(head_count_pc),
         !str_detect(country, '·'))


oecd_spec_gp_per_cap <- read_excel('data/OECD/specialists_gps_per_cap_long.xlsx', 
                           skip = 3) %>% 
  clean_names() %>% 
  rename(country = 1) %>% 
  select(-c(time_period_2, x27)) %>% 
  #data cleaning
  mutate(category = case_when(country == 'Health profession: Specialist medical practitioners' ~ 'Specialist',
                              country == 'Health profession: General practitioners' ~ 'General practice', 
                              .default = NA)) %>% 
  fill(category) %>% 
  pivot_longer(cols = contains('x'), 
               names_to = 'year', 
               values_to = 'head_count_pc') %>% 
  mutate(year = str_remove(year, 'x') %>% as.numeric()) %>% 
  filter(!is.na(head_count_pc),
         !str_detect(country, '·'))

#join physician and specialisation data
#calculate number of non-specialised physicians in 2022
oecd_medical_per_cap_22 <- bind_rows(oecd_physician_per_cap,
                                  oecd_spec_gp_per_cap) %>% 

  group_by(country) %>% 
  mutate(max_year = min(max(year), 2022)) %>% 
  filter(!is.na(head_count_pc),
         year == max_year) %>% 
  mutate(n = n()) %>% 
  #only include countries with all three entries (phys, gp, spec)
  filter(n == 3)
```

Plot first chart.

```{r}
pal <- c('0' = grattan_grey1, '1' = grattan_yellow, '2' = grattan_orange,
         '3' = grattan_red, grattan_blue2 = '4')

p_phys <- oecd_medical_per_cap_22 %>% 
  filter(category == 'Physician') %>% 
  mutate(aus = case_when(country == 'Australia'~'1', 
                         country == 'New Zealand' ~ '2',
                         country == 'United Kingdom' ~ '3',
                         country == 'Germany' ~ '4',
                         .default = '0')) %>%
  ungroup() %>% 
  ggplot(aes(x = reorder(country, head_count_pc), y = head_count_pc*100, fill = aus)) +
  geom_col() +
  #scale_x_discrete(labels = function(x) ifelse(x == 'Australia', 'Australia', "")) +
  grattan_y_continuous(limits = c(0, 550),
                       breaks = c(0,100,200,300,400,500)) +
  coord_flip() +
  theme_grattan(base_size = 16, flipped = T) +
  theme(axis.text.y = element_blank(),
        axis.ticks.y = element_blank()) +
  scale_fill_manual(values = pal) +
   labs(x = "",
        y = "")

