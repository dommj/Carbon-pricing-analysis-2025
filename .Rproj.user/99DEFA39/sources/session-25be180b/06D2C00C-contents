```{r}

oecd_medical_per_cap_22 %>% 
   mutate(category = factor(category, levels = c('Physician', 'Specialist', 'General practice'))) %>%
  group_by(category) %>% 
  arrange(head_count_pc) %>% 
  mutate(aus = if_else(country == 'Australia', 1, 0)) %>% 
  ungroup() %>% 
  ggplot(aes(x = reorder_within(country, head_count_pc, category), y = head_count_pc, fill = aus)) +
  facet_wrap(~ category, scales = 'free_y') +
  scale_x_reordered() +
  geom_col() +
