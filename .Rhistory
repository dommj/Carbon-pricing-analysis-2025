left_join(average_km_per_vehicle) %>%
mutate(average_petrol_use_per_household = num_ice * average_kilometres_travelled * fuel_l_km,
electrification = T) %>%
select(year, state, average_petrol_use_per_household, electrification) %>%
ungroup() %>%
filter(year <= 2050)
View(petrol_use)
