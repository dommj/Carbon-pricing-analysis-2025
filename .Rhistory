#| echo: false
#|output: false
knitr::opts_knit$set(root.dir = rprojroot::find_rstudio_root_file())
#| echo: false
#| label: load-packages
#| include: false
#| output: false
#run setup if not already done
source('R/setup.R')
#| echo: false
#| output: false
step_change_ems <- read_excel('Data/2024 ISP generation and storage outlook/Core/2024 ISP - Step Change - Core.xlsx',
sheet = 'Summary',
range = "H210:AK211") %>%
clean_names() %>%
pivot_longer(cols = contains('20'),
names_to = 'year',
values_to = 'mt_co2e') %>%
rename(scenario = 1) %>%
mutate(scenario = '2024 ISP - Step Change',
year = as.numeric(sub(".*_(\\d{2})", "20\\1", year))) %>%
select(- total)
#| echo: false
#| output: false
step_change_gen <- read_excel('Data/2024 ISP generation and storage outlook/Core/2024 ISP - Step Change - Core.xlsx',
sheet = 'Summary',
range = "H57:AJ72") %>%
clean_names() %>%
pivot_longer(cols = contains('20'),
names_to = 'year',
values_to = 'twh_gen') %>%
rename(technology = 1) %>%
mutate(year = as.numeric(sub(".*_(\\d{2})", "20\\1", year)),
type = case_when(str_detect(technology, 'coal')|
str_detect(technology, 'gas') ~ 'non-renewable',
str_detect(technology, '[w|W]ind')|
str_detect(technology, 'solar')|
str_detect(technology, 'PV')|
str_detect(technology, 'renewable')|
str_detect(technology, 'Hydro')|
str_detect(technology, 'DSP') ~ 'renewable',
.default = 'storage'))
#group_by(year) %>%
#mutate(pct_renewable = sum(twh_gen[type == 'renewable']) /(sum(twh_gen[type == 'renewable']) + sum(twh_gen[type == 'non-renewable'])))
#| echo: false
#| output: false
intensity_existing <- read_excel('Data/2024 ISP Inputs and Assumptions workbook.xlsx',
sheet = 'Emissions intensity',
range = "B7:D73") %>%
clean_names()
intensity_new <- read_excel('Data/2024 ISP Inputs and Assumptions workbook.xlsx',
sheet = 'Emissions intensity',
range = "F7:G26") %>%
clean_names()
total_gen <- step_change_gen %>%
group_by(year) %>%
summarise(twh_gen = sum(twh_gen))
nem_intensity <- total_gen %>%
full_join(step_change_ems %>% select(-scenario), join_by(year)) %>%
mutate(intensity_kg_co2e_mwh = (mt_co2e * 1e3 ) / (twh_gen))
nem_intensity %>%
ggplot(aes(x = year, y = intensity_kg_co2e_mwh)) +
geom_line() +
geom_point() +
theme_grattan() +
labs(title = "Title",
subtitle = "Projected emissions intensity for the NEM (kg CO₂-e per MWh)",
y = "",
x = "")
nem_intensity %>%
ggplot(aes(x = year, y = intensity_kg_co2e_mwh)) +
geom_line() +
geom_point() +
theme_grattan() +
labs(title = "The emissions intensity of the NEM falls quickly, then slowly to 2040",
subtitle = "Projected emissions intensity for the NEM (kg CO₂-e per MWh)",
y = "",
x = "")
nem_intensity %>%
ggplot(aes(x = year, y = intensity_kg_co2e_mwh)) +
geom_line() +
geom_point() +
theme_grattan() +
labs(title = "The emissions intensity of the NEM falls quickly, then slowly to 2040",
subtitle = "Projected emissions intensity for the NEM (kg CO₂-e per MWh)",
y = "",
x = "")
