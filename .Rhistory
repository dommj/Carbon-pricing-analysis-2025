?approx
cca_intensities_interpolated <- cca_intensities %>%
complete(scenario, year = seq(2025, 2050, by = 1)) %>%
# Group by scenario to interpolate within each scenario
group_by(scenario) %>%
# Use approx to linearly interpolate missing values
arrange(year) %>%
mutate(mt_c02e_twh = approx(x = year[!is.na(mt_c02e_twh)],
y = mt_c02e_twh[!is.na(mt_c02e_twh)],
xout = year)$y) %>%
ungroup()
View(cca_intensities_interpolated)
emissions <- full_join(cca_intensities_interpolated, esoo_demand)
View(emissions)
nem_emissions <- full_join(cca_intensities_interpolated, esoo_demand) %>%
mutate(emissions = annual )
nem_emissions <- full_join(cca_intensities_interpolated, esoo_demand) %>%
mutate(emissions = annual_consumption_t_wh * mt_c02e_twh)
emissions_budget <- nem_emissions %>%
group_by(scenario) %>%
summarise(budget = sum(emissions, na.rm = T))
View(emissions_budget)
emissions_budget <- nem_emissions %>%
filter(!is.na(scenario)) %>%
group_by(scenario) %>%
summarise(budget = sum(emissions))
