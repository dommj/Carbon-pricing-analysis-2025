label_data <- electrification_data %>%
# Calculate the y positions for the labels at the midpoints of each stack
group_by(year) %>%
arrange(category) %>%
mutate(y_position = cumsum(annual_cost_dollars),
y_position = y_position - 0.5 * annual_cost_dollars) %>%
ungroup()
